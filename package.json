{
  "name": "compaction-recall",
  "version": "0.1.0",
  "description": "Lexical recall for Pi's compacted history, with automatic locators and bounded grep/expand tools",
  "license": "MIT",
  "author": "shttty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shttty/pi-context-recall.git"
  },
  "homepage": "https://github.com/shttty/pi-context-recall#readme",
  "bugs": {
    "url": "https://github.com/shttty/pi-context-recall/issues"
  },
  "files": [
    "src/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "24.19.0",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@node-rs/jieba": "2.0.3"
  }
