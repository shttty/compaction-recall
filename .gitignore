# Dependencies, including local node_modules symlinks
node_modules
coverage/
*.tsbuildinfo
*.log
.env
.env.*
!.env.example
.DS_Store

# Public benchmark downloads (not extension runtime or committed fixtures)
benchmark/*.download*
benchmark/range.headers

# Generated run logs and redundant intermediate benchmark output
benchmark/blind-runs/
benchmark/stacked-progress.json
benchmark/stacked-summary.txt

# Local reranker runtimes, model weights and source-window payloads
benchmark/.venv-rerank/
benchmark/models/
benchmark/rerank-candidates.private.json

# Generated local runtime session marker
/:memory:.ses

# Python test and benchmark bytecode
__pycache__/
*.pyc

# Local SDK profiles and authentication (external configuration only)
.pi/
.pi-profile/
auth.json
models.json
settings.json

# npm cache used by prototype dependency installs
.npm-cache/
